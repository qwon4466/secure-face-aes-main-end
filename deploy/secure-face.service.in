# 템플릿 파일입니다. 직접 복사하지 말고 deploy/install.sh로 설치하세요.
# @...@ 자리표시자는 설치하는 기기의 계정·경로로 자동으로 채워집니다.
[Unit]
Description=SecureFace-RX CCTV server
Wants=network-online.target
After=network-online.target
RequiresMountsFor=@APP_DIR@

[Service]
Type=simple
User=@USER@
Group=@GROUP@
SupplementaryGroups=@SUPP_GROUPS@
WorkingDirectory=@APP_DIR@
ExecStart=@PYTHON@ @APP_DIR@/main.py
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
