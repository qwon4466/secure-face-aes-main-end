[Unit]
Description=SecureFace-RX boot clock sync (HTTP Date, for no RTC battery / blocked NTP)
Wants=network-online.target
After=network-online.target
# 녹화 폴더 이름·근무시간 판정·자동 삭제가 올바른 시각을 쓰도록 서버보다 먼저 실행
Before=secure-face.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/srx-set-clock
RemainAfterExit=yes
TimeoutStartSec=150

[Install]
WantedBy=multi-user.target
